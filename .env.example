NODE_ENV=development
PORT=3000
DATA_DIR=./data
APP_ORIGIN=http://localhost:3000
STORE_READY=false
PUBLIC_BUSINESS_NAME=
PUBLIC_SUPPORT_EMAIL=
PUBLIC_SUPPORT_PHONE=
PUBLIC_RETURN_ADDRESS=
SHIPPING_FEE_PAISE=0
RESEND_API_KEY=
MAIL_FROM=
ADMIN_EMAIL=
ADMIN_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Keep all launch gates closed until the operator verifies each requirement.
HIDE_PUBLIC_PRODUCTS=true
FULFILMENT_APPROVED=false
POLICIES_APPROVED=false
NOTIFICATIONS_APPROVED=false
SHIPPING_GST_BPS=
COD_APPROVED=false
COD_PINCODES=
SERVICEABLE_PINCODES=
PAYMENTS_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LIVE_PAYMENTS_APPROVED=false
PAYMENT_PRODUCTION_VERIFIED=false
REFUNDS_APPROVED=false
DAILY_BACKUPS=false
# Private object-storage credentials belong only in hosting configuration.
OFFSITE_BACKUPS=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_URL_STYLE=virtual-host
BACKUP_S3_PREFIX=asryo-production
